# ── Security & Authentication ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_signing_key_here
ENCRYPTION_KEY=your_aes_256_encryption_key_here

# ── Telegram Bot (Optional for Real-Time Signals) ─────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret
ADMIN_TELEGRAM_CHAT_ID=your_telegram_admin_chat_id

# ── Google Gemini AI Engine ───────────────────────────────────────────────────
GEMINI_API_KEY=your_google_gemini_api_key

# ── TypeSafe AI Engine (Jev System-1 Model) ───────────────────────────────────
TYPESAFE_API_KEY=your_typesafe_api_key_here

# ── Cron Security ─────────────────────────────────────────────────────────────
CRON_SECRET=your_cron_secret_token

# ── Application Configuration ─────────────────────────────────────────────────
PORT=3005
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3005
DEFAULT_LANGUAGE=en

# New entries require deliberate activation; monitoring remains enabled.
TRADING_ENABLED=false
TRADING_ACCOUNT_IS_DEDICATED=false
ENCRYPTION_KEY_VERSION=1
ADMIN_TELEGRAM_USER_IDS=
TYPESAFE_MODEL=jev-latest
GEMINI_MODEL=gemini-2.5-flash
# Test/demo hosts may be configured explicitly; account UID verification uses Spot Account API.
BINANCE_SPOT_URL=https://api.binance.com
BINANCE_FUTURES_URL=https://fapi.binance.com

# Optional backup directory; default is backups/ beside DB_PATH. Protect and monitor disk usage.
# BACKUP_DIR=/app/data/backups

# Explicit local user IDs: only these users may connect keys or create new entries (max 2).
TRADING_USER_IDS=
# Public signup is closed unless a strong invitation secret is configured.
REGISTRATION_SECRET=
